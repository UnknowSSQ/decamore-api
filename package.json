{
  "name": "decamore-api",
  "version": "0.1.0",
  "private": true,
  "description": "Decamore API — 对外公开 JSON 接口的站点与管理控制台（Next.js App Router + Zod 校验 + 运行时安全策略）",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 --turbopack",
    "dev:webpack": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register.mjs --import tsx --test \"tests/*.test.ts\"",
    "env:check": "tsx scripts/check-env.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "next": "15.5.27",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.27",
    "postcss": "^8.4.49",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
