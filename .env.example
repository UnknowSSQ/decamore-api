# 复制为 .env.local；.env.local 已被 .gitignore 忽略，不要提交真实密钥。
# NEXT_PUBLIC_ 开头的变量会打包进浏览器，密钥只能放服务端变量。

NODE_ENV=development

# 同域部署留空；跨域部署填完整 API 基址
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 必填，至少 32 字符：openssl rand -base64 48
# 这行是示例值，本地调试可用；NODE_ENV=production 时沿用它会被启动校验拒绝
JWT_SECRET=aG93cy1zZWNyZXQtNTk0OGJlYzI5OWE0MjQzODhkYzJjM2YxNmM0ZjA0Njc1ZDc0N2Y4ZTU0

# 秒：默认 access 15 分钟 / refresh 7 天
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800

# 跨子域共享会话与强制 Secure，通常不设
# COOKIE_DOMAIN=.decamore.dev
# COOKIE_SECURE=true

RATE_LIMIT_PER_MIN=120

# debug | info | warn | error
LOG_LEVEL=info

# 跨实例状态后端：memory（默认，单实例）或 redis（多实例共享限流与后台配置）
KV_BACKEND=memory
# KV_BACKEND=redis 时填写，形如 redis://user:pass@host:6379
# REDIS_URL=redis://localhost:6379
