# ---------- 依赖 ----------
/node_modules
/.pnp
.pnp.js

# ---------- Next 构建产物 ----------
/.next/
/out/
next-env.d.ts
/tsconfig.tsbuildinfo
/.swc/

# ---------- 生产构建 ----------
/build
/dist

# ---------- 环境变量（密钥绝不入库） ----------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# 仅提交示例文件
!.env.example

# ---------- 日志 ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/logs/
*.log

# ---------- 测试 / 覆盖率 ----------
/coverage
/.nyc_output

# ---------- 编辑器 / 系统 ----------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
*.pem
Thumbs.db

# ---------- 其它 ----------
.vercel
*.tsbuildinfo
/public/sw.js
/public/workbox-*.js

# 上游壁纸镜像：运行时由 lib/server/wallpaper.ts 回源落盘，不入库（bing 每天约 400KB、nasa 约 210KB）
public/assets/wallpaper/bing/
public/assets/wallpaper/nasa/

# ---------- 本地分析 / 抓取产物 ----------
# 代码分析报告与截图（含 analysis-report/_shots 下数 MB 图片），仅本地留档
/analysis-report/
# doc-fetch 抓取下来的参考 HTML，临时素材不入库
/doc-fetch-resources/
